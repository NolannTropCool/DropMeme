# Create a Discord application + bot at https://discord.com/developers/applications
# Enable the privileged Message Content Intent, then invite with bot + applications.commands.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Comma-separated channel IDs, from that guild only.
ALLOWED_CHANNEL_IDS=

# Public HTTPS URL handled by your existing Traefik / Coolify proxy.
PUBLIC_URL=https://dropmeme.example.com

# Optional: enables direct channel-ID subscription. Use a random secret of at least 24 characters.
# With this unset, users pair only through /dropmeme.
# JOIN_KEY=

# Optional: enables GIF search and sending from the app through Klipy (https://klipy.com/developers).
# Server-side use and re-hosting require Klipy's written approval (developers@klipy.com) and a production key;
# a test key is limited to 100 requests per hour. With this unset, GIF search is disabled.
# GIF_API_KEY=

MAX_MEDIA_MB=25
MAX_CLIENTS=100
