# Create a Discord application + bot at https://discord.com/developers/applications
# Enable the privileged Message Content Intent, then invite with bot + applications.commands.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Comma-separated channel IDs, from that guild only.
ALLOWED_CHANNEL_IDS=

# Public HTTPS hostname; DNS must point to the mini-PC for automatic TLS.
DOMAIN=dropmeme.example.com
PUBLIC_URL=https://dropmeme.example.com

# Optional: enables direct channel-ID subscription. Use a random secret of at least 24 characters.
# With this unset, users pair only through /dropmeme.
# JOIN_KEY=

MAX_MEDIA_MB=25
MAX_CLIENTS=100
