{
  "name": "@dropmeme/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "register": "node --env-file-if-exists=../../.env --import tsx src/register.ts"
  },
  "dependencies": {
    "@dropmeme/shared": "0.1.0",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.3",
    "discord.js": "14.27.0",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": { "tsx": "4.23.15", "@types/ws": "8.18.2", "ws": "8.22.0" }
}
