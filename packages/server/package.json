    "@fastify/websocket": "11.3.3",
    "discord.js": "14.27.0",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "ws": "8.22.0"
