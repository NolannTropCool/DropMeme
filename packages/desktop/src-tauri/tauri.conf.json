{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropMeme",
  "version": "0.2.0",
  "identifier": "com.dropmeme.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DropMeme",
        "width": 920,
        "height": 870,
        "minWidth": 560,
        "minHeight": 600,
        "backgroundColor": "#141615",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "quick-send",
        "url": "quick-send.html",
        "title": "DropMeme · Envoi rapide",
        "width": 640,
        "height": 360,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http://localhost:* http://127.0.0.1:*; media-src 'self' https: http://localhost:* http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Les médias Discord sur votre écran",
    "longDescription": "DropMeme affiche les images, GIF, vidéos et fichiers audio d’un salon Discord dans une superposition personnalisable.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEMDA2QzU0REFFQkZGN0UKUldSKy8rdmFWR3dBYlVWaWpDYlNGOUZEcW9LTGMxUWRoUk94Qk9NODFDYXR0Q0lnakpBa0lmTngK",
      "endpoints": [
        "https://github.com/NolannTropCool/DropMeme/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
